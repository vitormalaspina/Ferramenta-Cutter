# ============================================================
# YouTube Cutter — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste conforme necessário
# ============================================================

# Porta do backend FastAPI
APP_PORT=8000

# Porta do frontend React
FRONTEND_PORT=3000

# Diretório para arquivos temporários (downloads)
TEMP_DIR=storage/temp

# Diretório para os ZIPs e cortes finais
OUTPUT_DIR=storage/output

# Número máximo de vídeos processados simultaneamente
MAX_CONCURRENT_JOBS=2

# Tempo (em horas) para manter arquivos temporários antes de limpar
TEMP_FILE_TTL_HOURS=24

# Tempo (em horas) para manter ZIPs antes de limpar
ZIP_FILE_TTL_HOURS=72

# ============================================================
# Configurações de IA (Prioridade 3 — não obrigatório)
# ============================================================

# OpenAI API Key (para análise de melhores momentos)
# OPENAI_API_KEY=

# Modelo OpenAI a usar (padrão: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Whisper model size: tiny, base, small, medium, large
# WHISPER_MODEL=base

# ============================================================
# Configurações de Log
# ============================================================

# Nível de log: debug, info, warning, error
LOG_LEVEL=info

# ============================================================
# Segurança (aplicação local)
# ============================================================

# Bind address — manter como 127.0.0.1 para segurança local
BIND_HOST=127.0.0.1

